# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/

# Virtual environments
venv/
env/
.venv/
envs/
ENV/

# Environment variables and secrets
.env
.env.*
*.pem
*.key
credentials.json
secrets.json
secrets/

# Jupyter
.ipynb_checkpoints/

# Datasets (raw data is not committed)
data/raw/
data/processed/securebert/
data/processed/securebert_debiased/
*.csv
*.feather
*.arff
# Keep curated result tables tracked (raw data above stays ignored)
!results/*.csv

# Model weights and artifacts
*.pkl
*.joblib
*.h5
*.pt
*.pth
*.onnx
/models/
artifacts/
mlruns/
wandb/
*.ubj

# Results and local experiment outputs
results/**/*.png
results/**/*.pdf
results/**/*.html
# Keep curated evidence figures (PR curve, confusion matrix, dashboard shots)
!results/figures/
!results/figures/*.png
experiments/
logs/
*.log

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/
*.tmp

# Local planning folder (tracked collection assets live in scripts/)
vm/

# Trained models (only the frozen artifacts the API/dashboard need are tracked)
results/models/*
!results/models/preprocessor.joblib
!results/models/xgb_baseline.joblib
!results/models/encoder_scaler.joblib
!results/models/encoder_head.joblib

